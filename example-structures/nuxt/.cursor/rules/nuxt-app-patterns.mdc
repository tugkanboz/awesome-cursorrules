## State Management with Pinia

```typescript
// ✅ stores/auth.ts
export const useAuthStore = defineStore('auth', () => {
  const user = ref<User | null>(null)
  const token = useCookie<string | null>('auth-token', { default: () => null })

  const isAuthenticated = computed(() => !!user.value && !!token.value)

  async function login(email: string, password: string) {
    const response = await $fetch<{ user: User; token: string }>('/api/auth/login', {
      method: 'POST',
      body: { email, password },
    })
    user.value = response.user
    token.value = response.token
    await navigateTo('/dashboard')
  }

  async function logout() {
    await $fetch('/api/auth/logout', { method: 'POST' })
    user.value = null
    token.value = null
    await navigateTo('/login')
  }

  async function fetchCurrentUser() {
    if (!token.value) return
    try {
      user.value = await $fetch<User>('/api/auth/me', {
        headers: { authorization: `Bearer ${token.value}` },
      })
    } catch {
      user.value = null
      token.value = null
    }
  }

  return { user: readonly(user), isAuthenticated, login, logout, fetchCurrentUser }
})
```

## Nuxt Config Best Practices

```typescript
// ✅ nuxt.config.ts
export default defineNuxtConfig({
  compatibilityDate: '2024-11-01',
  devtools: { enabled: true },

  modules: [
    '@pinia/nuxt',
    '@nuxt/image',
    '@nuxtjs/tailwindcss',
    '@nuxt/icon',
  ],

  runtimeConfig: {
    // Server-only secrets (never exposed to client)
    databaseUrl: process.env.DATABASE_URL,
    jwtSecret: process.env.JWT_SECRET,

    // Exposed to client via useRuntimeConfig().public
    public: {
      apiBase: process.env.API_BASE ?? '/api',
      appName: 'My Nuxt App',
    },
  },

  typescript: {
    strict: true,
  },

  nitro: {
    storage: {
      db: { driver: 'fs', base: './.data/db' },
    },
  },
})
```

## Key Rules

- **Auto-imports**: Components, composables, and utils are auto-imported — no manual `import` needed for files in `components/`, `composables/`, `utils/`
- **`useState` for SSR-safe shared state** — use it instead of a raw `ref` at the module level to avoid hydration mismatches
- **`useCookie` for persistent state** — reads/writes cookies in both client and server contexts
- **`$fetch` vs `useFetch`**: use `$fetch` inside event handlers and composables; use `useFetch`/`useAsyncData` in components/pages for SSR + hydration support
- **Avoid `window`/`document` at module level** — wrap in `onMounted` or check `import.meta.client`
- **`definePageMeta` must be a static literal** — no dynamic values; it's extracted at build time
- **Server routes are file-name-routed**: `users.get.ts` → `GET /api/users`; `[id].delete.ts` → `DELETE /api/users/:id`
